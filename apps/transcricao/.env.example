# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Railway Web Service)
# ==============================================================================

# GEMINI_API_KEY: (Obrigatório no Backend) Chave da API do Google Gemini
GEMINI_API_KEY=

# PORT: (Automático no Render/Railway) Porta do Web Service HTTP. Padrão: 3000
PORT=3000

# FRONTEND_URL: (Opcional no Backend) URL específica do frontend para CORS (ex: https://seu-app.vercel.app)
# Se não fornecido, todas as URLs *.vercel.app e localhost já são permitidas automaticamente
FRONTEND_URL=

# ALLOWED_ORIGINS: (Opcional no Backend) Lista de origens permitidas separadas por vírgula
ALLOWED_ORIGINS=

# NODE_ENV: production (definido automaticamente pelo Render/Railway)
NODE_ENV=production


# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==============================================================================

# VITE_BACKEND_URL: URL pública do seu Web Service no Render ou Railway (ex: https://sua-api.onrender.com)
# Utilizada pelo frontend hospedado na Vercel para enviar os áudios diretamente ao backend Express.
VITE_BACKEND_URL=

